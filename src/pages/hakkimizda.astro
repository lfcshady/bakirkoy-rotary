---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Section from '../components/Section.astro';
import Gorsel from '../components/Gorsel.astro';
import DonemCizelgesi from '../components/DonemCizelgesi.astro';
import UyelikCTA from '../components/UyelikCTA.astro';
import { site } from '../data/site.ts';
import { hizmetYollari } from '../data/rotary.ts';
---

<Base
  title="Kulüp"
  description="Bakırköy Rotary Kulübü hakkında: kuruluşu, çalışma biçimi, hizmet yolları ve dönem yönetimi."
>
  <SayfaBasligi
    eyebrow="Hakkımızda"
    baslik="Kulüp"
    giris="Bakırköy Rotary Kulübü, Uluslararası Rotary UR 2420. Bölge’ye bağlı bir hizmet kulübüdür. Farklı mesleklerden üyeler, haftalık toplantılarda bir araya gelir ve kulübün projelerini birlikte yürütür."
  />

  <Section tone="dark">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-7">
        <div class="prose-tr text-base leading-relaxed text-onink-mute" data-reveal>
          <p>
            Rotary’nin çalışma biçimi basittir: bir toplulukta ihtiyaç vardır, o toplulukta
            o ihtiyacı karşılayabilecek mesleklerden insanlar vardır, ve kulüp bu ikisini
            buluşturur. Kulüp bir bağış kutusu değil, işi yapan bir yapıdır.
          </p>
          <p>
            Üyelik, meslek temsili esasına dayanır: kulüp, bulunduğu bölgedeki farklı meslek
            gruplarından üyeler taşımayı gözetir. Bu, projelerin yalnızca para değil, bilgi
            ve emekle de desteklenmesini sağlar.
          </p>
          <p>
            Kulüp her Rotary yılında yönetimini yeniler. Devir 1 Temmuz’da yapılır; yeni
            dönem başkanı kendi ekibini ve dönem hedeflerini açıklar. Kulübün belleği
            bültenlerde ve proje arşivinde tutulur.
          </p>
        </div>

        <dl class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2" data-reveal>
          <div class="bg-ink p-5">
            <dt class="eyebrow text-onink-mute">Kuruluş yılı</dt>
            <dd class="mt-2 font-display text-xl uppercase text-onink-mute">
              {site.kurulusYili ?? 'Kulüpten bekleniyor'}
            </dd>
          </div>
          <div class="bg-ink p-5">
            <dt class="eyebrow text-onink-mute">Kulüp numarası</dt>
            <dd class="mt-2 font-display text-xl uppercase text-onink-mute">
              {site.kulupNo ?? 'Kulüpten bekleniyor'}
            </dd>
          </div>
          <div class="bg-ink p-5">
            <dt class="eyebrow text-onink-mute">Bölge</dt>
            <dd class="display mt-2 text-xl">
              <a
                href={site.bolgeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-gold">UR 2420. Bölge ↗</a
              >
            </dd>
          </div>
          <div class="bg-ink p-5">
            <dt class="eyebrow text-onink-mute">Üye sayısı</dt>
            <dd class="mt-2 font-display text-xl uppercase text-onink-mute">
              {site.uyeSayisi ?? 'Kulüpten bekleniyor'}
            </dd>
          </div>
        </dl>
      </div>

      <div class="md:col-span-5" data-reveal data-reveal-delay="0.08">
        <Gorsel ratio="3 / 4" tone="dark" label="Kulüp toplantısı fotoğrafı bekleniyor" />
      </div>
    </div>
  </Section>

  <Section
    tone="light"
    eyebrow="Beş hizmet yolu"
    baslik="Kulübün işi nasıl bölünür"
  >
    <p slot="giris" class="mt-6 max-w-[58ch] text-base leading-relaxed text-onpaper-mute">
      Rotary, kulüp çalışmalarını beş hizmet yolunda tanımlar. Kulübün komiteleri de bu
      ayrım üzerine kurulur.
    </p>

    <ol class="border-t border-line-dark">
      {
        hizmetYollari.map((h, i) => (
          <li
            class="grid gap-3 border-b border-line-dark py-7 md:grid-cols-12 md:gap-6"
            data-reveal
            data-reveal-delay={String(0.04 * i)}
          >
            <span class="stamp text-xs text-royal md:col-span-1">0{i + 1}</span>
            <h3 class="display text-2xl text-onpaper md:col-span-4">{h.ad}</h3>
            <p class="text-sm leading-relaxed text-onpaper-mute md:col-span-7">{h.ozet}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <DonemCizelgesi />
  <UyelikCTA />
</Base>
