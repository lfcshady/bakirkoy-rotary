---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import { bultenler, tarihTR } from '../data/icerik.ts';
import { taslak } from '../data/site.ts';

/** Bulletins are grouped by Rotary year — the club's own filing system. */
const gruplar = [...new Set(bultenler.map((b) => b.donem))]
  .sort()
  .reverse()
  .map((donem) => ({
    donem,
    kayitlar: bultenler.filter((b) => b.donem === donem).sort((a, b) => b.sayi - a.sayi),
  }));
---

<Base
  title="Bülten Arşivi"
  description="Bakırköy Rotary Kulübü bültenleri — dönem dönem arşivlenmiş kulüp yayınları."
>
  <SayfaBasligi
    eyebrow="Yayın"
    baslik="Bülten arşivi"
    giris="Bülten, bir Rotary kulübünün kendi belleğidir: o hafta ne konuşuldu, hangi proje nereye vardı, kim konuk oldu. Arşiv dönem dönem tutulur."
  />

  <Section tone="dark">
    {
      gruplar.map((g, gi) => (
        <div class:list={['', gi > 0 && 'mt-20']}>
          <div class="flex items-center gap-4">
            <h2 class="display text-3xl text-onink">{g.donem}</h2>
            <span class="h-px flex-1 bg-line" aria-hidden="true" />
            <span class="eyebrow text-onink-mute">{g.kayitlar.length} sayı</span>
          </div>

          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {g.kayitlar.map((b, i) => (
              <li
                class="group flex flex-col border border-line"
                data-reveal
                data-reveal-delay={String(0.05 * i)}
              >
                <div class="overflow-hidden">
                  <div class="transition-transform duration-700 ease-out group-hover:scale-[1.04]">
                    <Foto
                      src={b.kapak}
                      alt={`${b.baslik} kapağı`}
                      ratio="4 / 3"
                      sizes="(max-width: 640px) 100vw, 25vw"
                    />
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-center gap-3">
                    <span class="stamp text-xs text-gold">Sayı {String(b.sayi).padStart(2, '0')}</span>
                    <time datetime={b.tarih} class="text-xs text-onink-mute">
                      {tarihTR(b.tarih)}
                    </time>
                  </div>

                  <h3 class="display mt-3 text-xl text-onink">{b.baslik}</h3>

                  <ul class="mt-4 space-y-1.5 text-sm text-onink-mute">
                    {b.icindekiler.map((i2) => (
                      <li class="flex gap-2.5">
                        <span class="mt-2 inline-block size-1 shrink-0 rotate-45 bg-gold" aria-hidden="true" />
                        {i2}
                      </li>
                    ))}
                  </ul>

                  <p class="mt-auto pt-6 eyebrow text-onink-mute">
                    {taslak ? 'PDF taslakta yok' : 'PDF indir'}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="mt-14 max-w-[62ch] text-sm text-onink-mute">
      Bültenler siteye doğrudan yüklenir; dış bir servise bağımlılık yoktur. Arşiv kulübün
      kuruluş dönemine kadar geriye doğru genişletilebilir.
    </p>
  </Section>
</Base>
