---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Gorsel from '../../components/Gorsel.astro';
import Taslak from '../../components/Taslak.astro';
import HaberListesi from '../../components/HaberListesi.astro';
import CogRule from '../../components/CogRule.astro';
import { haberler, tarihTR } from '../../data/icerik.ts';
import type { Haber } from '../../data/icerik.ts';

export function getStaticPaths() {
  return haberler.map((haber) => ({ params: { slug: haber.slug }, props: { haber } }));
}

interface Props { haber: Haber }
const { haber } = Astro.props;

const digerleri = haberler
  .filter((h) => h.slug !== haber.slug)
  .sort((a, b) => b.tarih.localeCompare(a.tarih))
  .slice(0, 2);
---

<Base
  title={haber.baslik}
  description={haber.ozet}
  schema={{
    '@type': 'NewsArticle',
    headline: haber.baslik,
    description: haber.ozet,
    datePublished: haber.tarih,
    inLanguage: 'tr-TR',
  }}
>
  <section class="bg-ink">
    <div class="mx-auto w-full max-w-[80rem] px-5 pb-14 pt-10 sm:px-8 md:pb-16 md:pt-14">
      <nav aria-label="Konum izi" class="eyebrow text-onink-mute">
        <a href="/haberler" class="transition-colors hover:text-gold">Haberler</a>
      </nav>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <time datetime={haber.tarih} class="stamp text-sm text-gold">
          {tarihTR(haber.tarih)}
        </time>
        {haber.taslak && <Taslak />}
      </div>

      <h1 class="display mt-5 max-w-[20ch] text-[clamp(2.25rem,6vw,4.5rem)]">
        {haber.baslik}
      </h1>
    </div>
  </section>

  <Section tone="dark">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-7" data-reveal>
        <p class="font-quote text-xl leading-relaxed text-onink">{haber.ozet}</p>
        <div class="prose-tr mt-8 border-t border-line pt-8 text-base leading-relaxed text-onink-mute">
          {haber.govde.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="md:col-span-5" data-reveal data-reveal-delay="0.08">
        <Gorsel ratio="4 / 3" tone="dark" label="Haber görseli bekleniyor" />
      </div>
    </div>
  </Section>

  <section class="bg-ink">
    <div class="mx-auto w-full max-w-[80rem] px-5 sm:px-8">
      <CogRule />
      <div class="py-20 md:py-section">
        <h2 class="display text-[clamp(1.75rem,4vw,2.75rem)]">Diğer duyurular</h2>
        <div class="mt-10">
          <HaberListesi haberler={digerleri} tone="dark" />
        </div>
      </div>
    </div>
  </section>
</Base>
