---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import DonemCizelgesi from '../components/DonemCizelgesi.astro';
import { donemler, yonetimKurulu, komiteler } from '../data/icerik.ts';

const donem = donemler[0];
---

<Base
  title="Yönetim ve Komiteler"
  description="Bakırköy Rotary Kulübü dönem başkanı, yönetim kurulu ve komite yapısı."
>
  <SayfaBasligi
    eyebrow="Yönetim"
    baslik="Dönem yönetimi"
    giris="Rotary kulüplerinde yönetim her yıl 1 Temmuz’da devredilir. Bu sayfa güncel dönemin başkanını, yönetim kurulunu ve komite yapısını gösterir."
  />

  <Section tone="dark">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4" data-reveal>
        <Foto
          src={donem.gorsel}
          alt={`${donem.baskan}, ${donem.kod} dönem başkanı`}
          ratio="3 / 4"
          odak="50% 18%"
          sizes="(max-width: 768px) 100vw, 33vw"
        />
      </div>

      <div class="md:col-span-8" data-reveal data-reveal-delay="0.08">
        <span class="stamp text-sm text-gold">{donem.kod} Dönemi</span>

        <h2 class="display mt-4 text-[clamp(2rem,5vw,3.25rem)]">{donem.baskan}</h2>
        <p class="mt-2 eyebrow text-onink-mute">{donem.meslek}</p>

        <p class="mt-6 font-quote text-xl italic text-gold">“{donem.tema}”</p>

        <div class="prose-tr mt-8 border-t border-line pt-8 text-base leading-relaxed text-onink-mute">
          {donem.mesaj.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </Section>

  <Section tone="light" eyebrow="Yönetim kurulu" baslik="Kurul üyeleri">
    <ul class="grid gap-px border border-line-dark bg-[rgb(10_23_48/0.14)] sm:grid-cols-2 lg:grid-cols-4">
      {
        yonetimKurulu.map((u, i) => (
          <li class="group bg-paper p-5" data-reveal data-reveal-delay={String(0.04 * i)}>
            <div class="overflow-hidden">
              <div class="transition-transform duration-700 ease-out group-hover:scale-[1.04]">
                <Foto
                  src={u.gorsel}
                  alt={`${u.ad}, ${u.gorev}`}
                  ratio="1 / 1"
                  odak="50% 22%"
                  veil={false}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                />
              </div>
            </div>
            <p class="mt-5 eyebrow text-royal">{u.gorev}</p>
            <p class="display mt-2 text-2xl text-onpaper">{u.ad}</p>
            <p class="mt-1 text-sm text-onpaper-mute">{u.meslek}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="dark" eyebrow="Komiteler" baslik="Kulübün çalışma birimleri">
    <ul class="border-t border-line">
      {
        komiteler.map((k, i) => (
          <li
            class="grid gap-3 border-b border-line py-7 md:grid-cols-12 md:items-baseline md:gap-6"
            data-reveal
            data-reveal-delay={String(0.04 * i)}
          >
            <h3 class="display text-2xl text-onink md:col-span-4">{k.ad}</h3>
            <p class="text-sm leading-relaxed text-onink-mute md:col-span-5">{k.ozet}</p>
            <p class="text-sm text-onink md:col-span-3 md:text-right">
              <span class="eyebrow mr-2 text-onink-mute">Başkan</span>
              {k.baskan}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <DonemCizelgesi />
</Base>
