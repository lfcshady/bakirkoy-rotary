---
import Base from '../layouts/Base.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Section from '../components/Section.astro';
import Gorsel from '../components/Gorsel.astro';
import Taslak from '../components/Taslak.astro';
import DonemCizelgesi from '../components/DonemCizelgesi.astro';
import { donemler, yonetimKurulu, komiteler } from '../data/icerik.ts';

const donem = donemler[0];
---

<Base
  title="Yönetim ve Komiteler"
  description="Bakırköy Rotary Kulübü dönem başkanı, yönetim kurulu ve komite yapısı."
>
  <SayfaBasligi
    eyebrow="Yönetim"
    baslik="Dönem yönetimi"
    giris="Rotary kulüplerinde yönetim her yıl 1 Temmuz’da devredilir. Bu sayfa güncel dönemin başkanını, yönetim kurulunu ve komite yapısını gösterir."
  />

  <Section tone="dark">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4" data-reveal>
        <Gorsel ratio="3 / 4" tone="dark" label="Dönem başkanı fotoğrafı bekleniyor" />
      </div>

      <div class="md:col-span-8" data-reveal data-reveal-delay="0.08">
        <div class="flex flex-wrap items-center gap-3">
          <span class="stamp text-sm text-gold">{donem.kod} Dönemi</span>
          {donem.taslak && <Taslak />}
        </div>

        <h2 class="display mt-4 text-[clamp(2rem,5vw,3.25rem)]">
          {donem.baskan ?? 'Dönem başkanı bilgisi bekleniyor'}
        </h2>

        {
          donem.tema ? (
            <p class="mt-3 font-quote text-xl italic text-onink-mute">{donem.tema}</p>
          ) : (
            <p class="mt-3 text-sm text-onink-mute">
              Uluslararası Rotary’nin dönem teması ve kulübün dönem hedefleri kulüpten
              geldiğinde burada yer alacaktır.
            </p>
          )
        }

        <div class="prose-tr mt-8 border-t border-line pt-8 text-base leading-relaxed text-onink-mute">
          {
            donem.mesaj ? (
              donem.mesaj.map((p) => <p>{p}</p>)
            ) : (
              <p>
                Başkan mesajı kulüpten geldiğinde bu alana yerleştirilecektir. Yapı hazır:
                başlık, fotoğraf, dönem teması ve metin.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </Section>

  <Section tone="light" eyebrow="Yönetim kurulu" baslik="Kurul üyeleri">
    <ul class="grid gap-px border border-line-dark bg-[rgb(10_23_48/0.14)] sm:grid-cols-2 lg:grid-cols-3">
      {
        yonetimKurulu.map((u, i) => (
          <li class="bg-paper p-6" data-reveal data-reveal-delay={String(0.04 * i)}>
            <Gorsel ratio="1 / 1" tone="light" label="Fotoğraf bekleniyor" class="mb-5" />
            <p class="eyebrow text-royal">{u.gorev}</p>
            <p class="display mt-2 text-2xl text-onpaper">
              {u.ad ?? <span class="text-onpaper-mute">İsim bekleniyor</span>}
            </p>
            {u.taslak && <Taslak class="mt-4" />}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="dark" eyebrow="Komiteler" baslik="Kulübün çalışma birimleri">
    <ul class="border-t border-line">
      {
        komiteler.map((k, i) => (
          <li
            class="grid gap-3 border-b border-line py-7 md:grid-cols-12 md:items-baseline md:gap-6"
            data-reveal
            data-reveal-delay={String(0.04 * i)}
          >
            <h3 class="display text-2xl text-onink md:col-span-4">{k.ad}</h3>
            <p class="text-sm leading-relaxed text-onink-mute md:col-span-5">{k.ozet}</p>
            <div class="flex items-center gap-3 md:col-span-3 md:justify-end">
              <span class="text-sm text-onink-mute">
                {k.baskan ?? 'Komite başkanı bekleniyor'}
              </span>
              {k.taslak && <Taslak />}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <DonemCizelgesi />
</Base>
