---
import ProjeKarti from './ProjeKarti.astro';
import CogRule from './CogRule.astro';
import { projeler } from '../data/icerik.ts';

const oneCikan = projeler.slice(0, 6);
---

<section class="bg-ink" aria-labelledby="projeler-baslik">
  <div class="mx-auto w-full max-w-[80rem] px-5 sm:px-8">
    <CogRule />
    <div class="pt-20 md:pt-section">
      <header class="flex flex-wrap items-end gap-6" data-reveal>
        <div>
          <p class="eyebrow text-gold">Çalışmalar</p>
          <h2 id="projeler-baslik" class="display mt-4 text-[clamp(2rem,5vw,3.5rem)]">
            Dönem dönem, iş üstünde
          </h2>
        </div>

        <div class="ml-auto flex items-center gap-2">
          <button
            type="button"
            class="grid size-11 place-items-center border border-line text-onink transition-colors hover:border-gold hover:text-gold disabled:opacity-35"
            data-serit-onceki
          >
            <span class="sr-only">Önceki projeler</span>
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="grid size-11 place-items-center border border-line text-onink transition-colors hover:border-gold hover:text-gold disabled:opacity-35"
            data-serit-sonraki
          >
            <span class="sr-only">Sonraki projeler</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </header>
    </div>
  </div>

  <!-- Full-bleed track: the row runs past the container, as a shelf should. -->
  <div class="pb-20 pt-10 md:pb-section md:pt-14">
    <ul
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 [scrollbar-width:none] sm:px-8 [&::-webkit-scrollbar]:hidden"
      data-serit
    >
      {
        oneCikan.map((p, i) => (
          <li
            class="w-[80vw] max-w-[26rem] shrink-0 snap-start sm:w-[46vw] lg:w-[30vw]"
            data-reveal
            data-reveal-delay={String(0.05 * i)}
          >
            <ProjeKarti proje={p} tone="dark" />
          </li>
        ))
      }
      <li class="w-[80vw] max-w-[26rem] shrink-0 snap-start sm:w-[46vw] lg:w-[30vw]">
        <a
          href="/projeler"
          class="group flex h-full flex-col justify-end border border-dashed border-line p-6 transition-colors hover:border-gold md:p-8"
        >
          <p class="display text-3xl text-onink">Tüm proje arşivi</p>
          <p class="mt-3 text-sm text-onink-mute">
            Döneme ve odak alanına göre filtrelenebilir.
          </p>
          <span class="mt-6 eyebrow text-gold">
            Arşive git <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  const serit = document.querySelector<HTMLElement>('[data-serit]');
  const onceki = document.querySelector<HTMLButtonElement>('[data-serit-onceki]');
  const sonraki = document.querySelector<HTMLButtonElement>('[data-serit-sonraki]');

  if (serit && onceki && sonraki) {
    const adim = () => serit.querySelector('li')?.clientWidth ?? 320;

    const durum = () => {
      onceki.disabled = serit.scrollLeft < 8;
      sonraki.disabled = serit.scrollLeft > serit.scrollWidth - serit.clientWidth - 8;
    };

    onceki.addEventListener('click', () =>
      serit.scrollBy({ left: -(adim() + 20), behavior: 'smooth' }),
    );
    sonraki.addEventListener('click', () =>
      serit.scrollBy({ left: adim() + 20, behavior: 'smooth' }),
    );
    serit.addEventListener('scroll', durum, { passive: true });
    window.addEventListener('resize', durum);
    durum();

    // Pointer drag — desktop convenience only; touch already scrolls natively.
    let aktif = false;
    let baslangicX = 0;
    let baslangicScroll = 0;

    serit.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      aktif = true;
      baslangicX = e.clientX;
      baslangicScroll = serit.scrollLeft;
      serit.style.cursor = 'grabbing';
    });
    const bitir = () => {
      aktif = false;
      serit.style.cursor = '';
    };
    serit.addEventListener('pointerup', bitir);
    serit.addEventListener('pointerleave', bitir);
    serit.addEventListener('pointermove', (e) => {
      if (!aktif) return;
      e.preventDefault();
      serit.scrollLeft = baslangicScroll - (e.clientX - baslangicX);
    });
  }
</script>
