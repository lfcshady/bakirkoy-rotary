---
import RotaryAmblem from './RotaryAmblem.astro';

/**
 * The club lockup: the Rotary wheel plus the club's own name. Nothing else —
 * the emblem carries the identity, the type just says which club this is.
 */
interface Props { size?: number; showText?: boolean; class?: string }
const { size = 34, showText = true, class: cls = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-3 ${cls}`}>
  <RotaryAmblem size={size} variant="gold" class="shrink-0" />
  {
    showText && (
      <span class="display text-[0.95rem] leading-[1.05] tracking-[0.02em]">
        <span class="block">Bakırköy</span>
        <span class="block text-onink-mute">Rotary Kulübü</span>
      </span>
    )
  }
</span>
