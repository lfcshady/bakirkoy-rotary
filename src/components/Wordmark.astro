---
/**
 * Club wordmark + an abstract cog ring.
 *
 * TODO(brief): the official Rotary masterbrand signature is an RI asset supplied
 * through the Brand Center or the club itself. Drop the SVG at
 * `public/rotary-amblem.svg` and swap the ring below for it. The emblem is never
 * redrawn, recoloured or distorted — the ring here is a neutral geometric motif,
 * not a stand-in for the emblem.
 */
interface Props { size?: number; showText?: boolean; class?: string }
const { size = 34, showText = true, class: cls = '' } = Astro.props;

const cogs = Array.from({ length: 24 }, (_, i) => (i * 360) / 24);
---

<span class={`inline-flex items-center gap-3 ${cls}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 100 100"
    aria-hidden="true"
    class="shrink-0"
    data-cog
  >
    <g fill="none" stroke="currentColor" stroke-width="4">
      <circle cx="50" cy="50" r="30"></circle>
      <circle cx="50" cy="50" r="9"></circle>
    </g>
    <g stroke="currentColor" stroke-width="3.5" stroke-linecap="butt">
      {
        cogs.map((deg) => (
          <line x1="50" y1="18" x2="50" y2="12" transform={`rotate(${deg} 50 50)`} />
        ))
      }
    </g>
    <g stroke="currentColor" stroke-width="3.5">
      {
        [0, 60, 120].map((deg) => (
          <line x1="50" y1="21" x2="50" y2="79" transform={`rotate(${deg} 50 50)`} />
        ))
      }
    </g>
  </svg>
  {
    showText && (
      <span class="display text-[0.95rem] leading-[1.05] tracking-[0.02em]">
        <span class="block">Bakırköy</span>
        <span class="block text-onink-mute">Rotary Kulübü</span>
      </span>
    )
  }
</span>
