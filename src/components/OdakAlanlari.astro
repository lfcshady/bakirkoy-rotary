---
import Section from './Section.astro';
import { odakAlanlari } from '../data/rotary.ts';

interface Props { tone?: 'dark' | 'light' }
const { tone = 'light' } = Astro.props;
---

<Section
  tone={tone}
  eyebrow="Rotary’nin yedi odak alanı"
  baslik="Kulübün işi bu yedi başlıkta toplanır"
>
  <p slot="giris" class="mt-6 max-w-[58ch] text-base leading-relaxed text-onpaper-mute">
    Rotary, dünya genelindeki bütün kulüplerin çalışmalarını yedi alanda tanımlar.
    Bakırköy Rotary’nin projeleri de bu başlıklar altında arşivlenir — böylece yapılan iş,
    hangi döneme ait olduğundan bağımsız olarak karşılaştırılabilir kalır.
  </p>

  <ul class="grid gap-px border border-line-dark bg-[rgb(10_23_48/0.14)] sm:grid-cols-2 lg:grid-cols-4">
    {
      odakAlanlari.map((o, i) => (
        <li
          class="group relative bg-paper p-6 transition-colors hover:bg-paper-2 md:p-8"
          data-reveal
          data-reveal-delay={String(0.04 * i)}
        >
          <span class="stamp text-xs text-royal">{o.no}</span>
          <h3 class="display mt-4 text-2xl text-onpaper">{o.ad}</h3>
          <p class="mt-3 text-sm leading-relaxed text-onpaper-mute">{o.ozet}</p>
          <span
            class="mt-6 block h-px w-10 bg-gold transition-all duration-300 group-hover:w-20"
            aria-hidden="true"
          />
        </li>
      ))
    }
    <li class="bg-paper p-6 md:p-8">
      <span class="stamp text-xs text-royal">↗</span>
      <h3 class="display mt-4 text-2xl text-onpaper">Kulübün projeleri</h3>
      <p class="mt-3 text-sm leading-relaxed text-onpaper-mute">
        Bakırköy Rotary’nin dönem dönem yürüttüğü çalışmaların tamamı arşivde.
      </p>
      <a
        href="/projeler"
        class="mt-6 inline-flex items-center gap-2 eyebrow text-royal underline-offset-4 hover:underline"
      >
        Projelere git <span aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</Section>
