---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Every photograph on the site goes through here: fixed aspect ratio, lazy by
 * default, and a faint navy veil so gold and white type stay legible on top of
 * warm stock photography without dimming the picture into mud.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  veil?: boolean;
  eager?: boolean;
  /** object-position, e.g. '50% 20%' to keep a face in frame. */
  odak?: string;
}
const {
  src,
  alt,
  ratio = '4 / 3',
  widths = [480, 800, 1200, 1600],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  class: cls = '',
  veil = true,
  eager = false,
  odak = '50% 50%',
} = Astro.props;
---

<figure class={`relative overflow-hidden bg-ink-2 ${cls}`} style={`aspect-ratio:${ratio}`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="size-full object-cover"
    style={`object-position:${odak}`}
  />
  {
    veil && (
      <span
        class="pointer-events-none absolute inset-0"
        style="background:linear-gradient(180deg,rgb(10 23 48 / 0.12) 0%,rgb(10 23 48 / 0.34) 100%)"
        aria-hidden="true"
      />
    )
  }
</figure>
