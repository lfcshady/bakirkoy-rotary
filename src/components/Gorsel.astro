---
/**
 * Image slot.
 *
 * No stock photography, ever. Until the club supplies its own archive this
 * renders a visibly-labelled empty plate built from the cog geometry, so the
 * layout is complete and the gap is honest.
 *
 * TODO(brief): club photo archive. When it arrives, copy files into
 * src/assets/ and swap this for <Image /> (see the media-pipeline skill).
 */
interface Props {
  ratio?: string;
  label?: string;
  class?: string;
  tone?: 'dark' | 'light';
}
const {
  ratio = '4 / 3',
  label = 'Görsel bekleniyor',
  class: cls = '',
  tone = 'dark',
} = Astro.props;

const bg = tone === 'dark' ? 'var(--color-ink-2)' : 'var(--color-paper-2)';
const fg = tone === 'dark' ? 'rgb(255 255 255 / 0.16)' : 'rgb(10 23 48 / 0.18)';
const txt = tone === 'dark' ? 'var(--color-onink-mute)' : 'var(--color-onpaper-mute)';
---

<div
  class={`relative overflow-hidden ${cls}`}
  style={`aspect-ratio:${ratio};background:${bg}`}
  role="img"
  aria-label={label}
>
  <div
    class="absolute inset-0"
    style={`background-image:repeating-linear-gradient(135deg,${fg} 0 1px,transparent 1px 11px)`}
  >
  </div>
  <div
    class="absolute inset-0 flex items-end p-4"
  >
    <span class="eyebrow" style={`color:${txt}`}>{label}</span>
  </div>
</div>
