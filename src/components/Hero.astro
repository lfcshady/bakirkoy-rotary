---
import RotaryAmblem from './RotaryAmblem.astro';
import { site } from '../data/site.ts';
import { guncelDonem } from '../data/rotary.ts';

const donem = guncelDonem();
---

<section class="relative overflow-hidden bg-ink">
  <!--
    The wheel. It is the club's emblem, so it is allowed to be the loudest thing
    on the page — it turns slowly on its own and picks up speed as you scroll.
    Shown at every width; on phones it sits behind the heading, bleeding off the
    right edge, which reads as intent rather than decoration.
  -->
  <div
    class="pointer-events-none absolute -right-[30%] top-[16%] w-[95vw] max-w-[760px] sm:-right-[22%] sm:top-1/2 sm:w-[70vw] sm:-translate-y-1/2 md:-right-[14%] md:w-[58vw]"
    aria-hidden="true"
  >
    <div class="relative">
      <div
        class="absolute inset-[12%] rounded-full opacity-40 blur-3xl"
        style="background:radial-gradient(circle,rgb(247 168 27 / 0.16),transparent 68%)"
      >
      </div>
      <RotaryAmblem
        size={760}
        variant="gold"
        class="relative w-full opacity-[0.22] sm:opacity-[0.26]"
        spin={true}
      />
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[80rem] px-5 pb-20 pt-16 sm:px-8 md:pb-28 md:pt-24">
    <p class="eyebrow text-gold" data-reveal>
      {site.bolge} · {site.sehir}
    </p>

    <h1
      class="display mt-6 text-[clamp(2.75rem,9vw,7rem)]"
      data-reveal
      data-reveal-delay="0.06"
    >
      Bakırköy<br />
      <span class="text-onink-mute">Rotary Kulübü</span>
    </h1>

    <div class="mt-10 grid gap-10 md:mt-14 md:grid-cols-12 md:gap-8">
      <p
        class="max-w-[46ch] text-lg leading-relaxed text-onink md:col-span-6 md:text-xl"
        data-reveal
        data-reveal-delay="0.12"
      >
        Farklı mesleklerden insanların, kendi mahallesinde kalıcı bir iyilik bırakmak için
        bir araya geldiği bir hizmet kulübü. Rotary’de her yıl yeniden başlar:
        yönetim döner, iş kalır.
      </p>

      <div class="md:col-span-6 md:justify-self-end" data-reveal data-reveal-delay="0.18">
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/projeler"
            class="group inline-flex items-center gap-3 bg-gold px-6 py-3.5 eyebrow text-ink transition-colors hover:bg-onink"
          >
            Projeleri gör
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a
            href="/uyelik"
            class="inline-flex items-center gap-3 border border-line-2 bg-ink/60 px-6 py-3.5 eyebrow text-onink backdrop-blur-sm transition-colors hover:border-gold hover:text-gold"
          >
            Rotaryen olmak
          </a>
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-px border border-line bg-line">
          <div class="bg-ink/85 p-4 backdrop-blur-sm">
            <dt class="eyebrow text-onink-mute">Dönem</dt>
            <dd class="stamp mt-2 text-2xl text-gold">{donem}</dd>
          </div>
          <div class="bg-ink/85 p-4 backdrop-blur-sm">
            <dt class="eyebrow text-onink-mute">Bölge</dt>
            <dd class="stamp mt-2 text-2xl">2420</dd>
          </div>
        </dl>
        <p class="mt-3 text-xs text-onink-mute">
          Rotary yılı 1 Temmuz’da başlar, 30 Haziran’da biter.
        </p>
      </div>
    </div>
  </div>
</section>
