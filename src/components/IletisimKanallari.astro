---
import { site, mailtoLink, whatsappLink } from '../data/site.ts';

/**
 * Every channel the club supplies becomes one click. Nothing is ever rendered as
 * dead text: a missing channel says plainly that it is missing.
 *
 * There is no backend and no database — see CLAUDE.md §3. Enquiries leave the
 * site through the visitor's own WhatsApp or mail client.
 */
interface Props {
  konu?: string;
  mesaj?: string;
  tone?: 'dark' | 'light';
}
const {
  konu = 'Bakırköy Rotary Kulübü — Bilgi talebi',
  mesaj = 'Merhaba, Bakırköy Rotary Kulübü hakkında bilgi almak istiyorum.',
  tone = 'dark',
} = Astro.props;

const kanallar = [
  {
    etiket: 'WhatsApp',
    deger: site.whatsapp,
    href: whatsappLink(mesaj),
    aciklama: 'En hızlı yol. Mesaj hazır gelir.',
    dis: true,
  },
  {
    etiket: 'E-posta',
    deger: site.email,
    href: mailtoLink(konu, mesaj),
    aciklama: 'Konu ve mesaj doldurulmuş olarak açılır.',
    dis: false,
  },
  {
    etiket: 'Telefon',
    deger: site.phoneDisplay ?? site.phone,
    href: site.phone ? `tel:${site.phone}` : null,
    aciklama: 'Toplantı saatleri dışında ulaşabilirsiniz.',
    dis: false,
  },
  {
    etiket: 'Instagram',
    deger: site.social.find((s) => s.label === 'Instagram')?.href ?? null,
    href: site.social.find((s) => s.label === 'Instagram')?.href ?? null,
    aciklama: 'Kulübün güncel paylaşımları.',
    dis: true,
  },
];

const line = tone === 'dark' ? 'border-line' : 'border-line-dark';
const bg = tone === 'dark' ? 'bg-ink' : 'bg-paper';
const muted = tone === 'dark' ? 'text-onink-mute' : 'text-onpaper-mute';
const title = tone === 'dark' ? 'text-onink' : 'text-onpaper';
---

<ul class={`grid gap-px border ${line} bg-[rgb(255_255_255/0.13)] sm:grid-cols-2`}>
  {
    kanallar.map((k) => (
      <li class={`${bg} p-6`}>
        <p class={`eyebrow ${muted}`}>{k.etiket}</p>
        {k.href ? (
          <>
            <a
              href={k.href}
              {...(k.dis ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class={`display mt-3 block break-words text-2xl transition-colors hover:text-gold ${title}`}
            >
              {k.deger}
            </a>
            <p class={`mt-2 text-xs ${muted}`}>{k.aciklama}</p>
          </>
        ) : (
          <p class={`mt-3 text-sm ${muted}`}>
            Kulüpten bekleniyor — geldiğinde tek tıkla bağlanacak.
          </p>
        )}
      </li>
    ))
  }
</ul>
