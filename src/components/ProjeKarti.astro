---
import Foto from './Foto.astro';
import { tarihTR } from '../data/icerik.ts';
import type { Proje } from '../data/icerik.ts';

interface Props { proje: Proje; tone?: 'dark' | 'light'; class?: string }
const { proje, tone = 'dark', class: cls = '' } = Astro.props;

const border = tone === 'dark' ? 'border-line' : 'border-line-dark';
const title = tone === 'dark' ? 'text-onink' : 'text-onpaper';
const muted = tone === 'dark' ? 'text-onink-mute' : 'text-onpaper-mute';
---

<!--
  One link per card: the title carries it and stretches over the whole card, so
  the image is clickable without adding a second, nameless anchor.
-->
<article class={`group relative flex h-full flex-col border ${border} ${cls}`}>
  <div class="overflow-hidden">
    <div class="transition-transform duration-700 ease-out group-hover:scale-[1.04]">
      <Foto src={proje.kapak} alt={`${proje.ad} projesinden bir kare`} ratio="3 / 2" />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 md:p-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="stamp text-xs text-gold">{proje.donem}</span>
      <span class={`text-xs ${muted}`}>{proje.odak}</span>
    </div>

    <h3 class={`display mt-4 text-2xl ${title}`}>
      <a
        href={`/projeler/${proje.slug}`}
        class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-gold"
      >
        {proje.ad}
      </a>
    </h3>

    <p class={`mt-2.5 text-sm leading-relaxed ${muted}`}>{proje.ozet}</p>

    <div class={`mt-auto flex items-center gap-3 pt-6 eyebrow ${muted}`}>
      <span>{proje.konum}</span>
      <span aria-hidden="true">·</span>
      <time datetime={proje.tarih}>{tarihTR(proje.tarih)}</time>
      <span
        class="ml-auto text-gold transition-transform duration-300 group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </div>
  </div>
</article>
