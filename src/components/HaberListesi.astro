---
import Foto from './Foto.astro';
import { tarihTR } from '../data/icerik.ts';
import type { Haber } from '../data/icerik.ts';

interface Props { haberler: Haber[]; tone?: 'dark' | 'light' }
const { haberler, tone = 'dark' } = Astro.props;

const line = tone === 'dark' ? 'border-line' : 'border-line-dark';
const muted = tone === 'dark' ? 'text-onink-mute' : 'text-onpaper-mute';
const title = tone === 'dark' ? 'text-onink' : 'text-onpaper';
---

<ul class={`border-t ${line}`}>
  {
    haberler.map((h, i) => (
      <li class={`border-b ${line}`} data-reveal data-reveal-delay={String(0.05 * i)}>
        <a
          href={`/haberler/${h.slug}`}
          class="group grid gap-5 py-7 md:grid-cols-12 md:items-center md:gap-6"
        >
          <div class="md:col-span-3">
            <div class="overflow-hidden">
              <div class="transition-transform duration-700 ease-out group-hover:scale-[1.05]">
                <Foto
                  src={h.kapak}
                  alt={h.baslik}
                  ratio="16 / 10"
                  sizes="(max-width: 768px) 100vw, 25vw"
                />
              </div>
            </div>
          </div>

          <div class="md:col-span-7">
            <time datetime={h.tarih} class={`stamp text-xs ${muted}`}>
              {tarihTR(h.tarih)}
            </time>
            <h3 class={`display mt-2 text-2xl transition-colors group-hover:text-gold ${title}`}>
              {h.baslik}
            </h3>
            <p class={`mt-2 max-w-[62ch] text-sm leading-relaxed ${muted}`}>{h.ozet}</p>
          </div>

          <div class="hidden md:col-span-2 md:flex md:justify-end">
            <span
              class="grid size-11 place-items-center border border-line text-gold transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>
