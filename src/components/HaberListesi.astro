---
import Taslak from './Taslak.astro';
import { tarihTR } from '../data/icerik.ts';
import type { Haber } from '../data/icerik.ts';

interface Props { haberler: Haber[]; tone?: 'dark' | 'light' }
const { haberler, tone = 'dark' } = Astro.props;

const line = tone === 'dark' ? 'border-line' : 'border-line-dark';
const muted = tone === 'dark' ? 'text-onink-mute' : 'text-onpaper-mute';
const title = tone === 'dark' ? 'text-onink' : 'text-onpaper';
---

{
  haberler.length === 0 ? (
    <p class={`border border-dashed ${line} p-8 text-sm ${muted}`}>
      Henüz yayımlanmış bir duyuru yok.
    </p>
  ) : (
    <ul class={`border-t ${line}`}>
      {haberler.map((h, i) => (
        <li
          class={`border-b ${line}`}
          data-reveal
          data-reveal-delay={String(0.05 * i)}
        >
          <a
            href={`/haberler/${h.slug}`}
            class="group grid gap-3 py-7 md:grid-cols-12 md:items-baseline md:gap-6"
          >
            <time
              datetime={h.tarih}
              class={`stamp text-xs md:col-span-2 ${muted}`}
            >
              {tarihTR(h.tarih)}
            </time>

            <div class="md:col-span-7">
              <h3 class={`display text-2xl transition-colors group-hover:text-gold ${title}`}>
                {h.baslik}
              </h3>
              <p class={`mt-2 max-w-[62ch] text-sm leading-relaxed ${muted}`}>{h.ozet}</p>
            </div>

            <div class="flex items-center gap-3 md:col-span-3 md:justify-end">
              {h.taslak && <Taslak />}
              <span
                class={`transition-transform duration-300 group-hover:translate-x-1 ${muted}`}
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
