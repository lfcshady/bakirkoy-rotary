---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, taslak } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  /** Page-specific schema.org node, merged into the graph. */
  schema?: Record<string, unknown>;
}
const { title, description, schema } = Astro.props;

const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const kurulus: Record<string, unknown> = {
  '@type': ['NGO', 'Organization'],
  '@id': new URL('/#kurulus', Astro.site).href,
  name: site.name,
  alternateName: site.shortName,
  url: Astro.site?.href,
  description:
    'Uluslararası Rotary UR 2420. Bölge’ye bağlı, Bakırköy’de faaliyet gösteren hizmet kulübü.',
  areaServed: 'Bakırköy, İstanbul',
  parentOrganization: { '@type': 'Organization', name: 'Rotary International', url: 'https://www.rotary.org' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: 'TR',
    ...(site.address.street ? { streetAddress: site.address.street } : {}),
    ...(site.address.postalCode ? { postalCode: site.address.postalCode } : {}),
  },
  // Only real, supplied values reach the graph.
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.email ? { email: site.email } : {}),
  ...(site.social.some((s) => s.href) ? { sameAs: site.social.filter((s) => s.href).map((s) => s.href) } : {}),
};

const graph = [kurulus, ...(schema ? [schema] : [])];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A1730" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      taslak ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <link rel="sitemap" href="/sitemap-index.xml" />
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>

  <body class="min-h-dvh">
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-gold focus:px-4 focus:py-2 focus:eyebrow focus:text-ink"
    >
      İçeriğe geç
    </a>

    {
      taslak && (
        <div class="border-b border-gold/25 bg-ink-2" data-taslak-bar>
          <div
            class="mx-auto flex max-w-[80rem] items-start gap-x-3 gap-y-1 px-5 py-2 sm:items-center sm:px-8"
          >
            <span class="eyebrow shrink-0 pt-[3px] text-gold sm:pt-0">Taslak sunum</span>
            <p class="min-w-0 flex-1 text-[0.72rem] leading-snug text-onink-mute sm:text-xs">
              Görseller ve bilgiler temsilidir. Kendi bilgilerinizle değiştirilecektir.{' '}
              <a
                href="/taslak"
                class="whitespace-nowrap border-b border-gold/50 text-gold transition-colors hover:border-gold"
              >
                Değişecek alanlar →
              </a>
            </p>
            <button
              type="button"
              class="grid size-6 shrink-0 place-items-center text-onink-mute transition-colors hover:text-onink"
              data-taslak-kapat
            >
              <span class="sr-only">Bu bildirimi kapat</span>
              <span aria-hidden="true">×</span>
            </button>
          </div>
        </div>
      )
    }

    <Header />

    <main id="icerik">
      <slot />
    </main>

    <Footer />

    <script>
      // Draft bar: dismissible for the length of the visit only.
      const bar = document.querySelector<HTMLElement>('[data-taslak-bar]');
      if (bar) {
        try {
          if (sessionStorage.getItem('taslak-bar') === 'kapali') bar.hidden = true;
        } catch {}
        bar.querySelector('[data-taslak-kapat]')?.addEventListener('click', () => {
          bar.hidden = true;
          try {
            sessionStorage.setItem('taslak-bar', 'kapali');
          } catch {}
        });
      }
    </script>

    <script>
      // Motion layer. Loaded once, degrades to plain static content if GSAP
      // fails or the visitor asked for reduced motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduced) {
        targets.forEach((el) => (el.style.opacity = '1'));
      } else {
        (async () => {
          try {
            const { gsap } = await import('gsap');
            const { ScrollTrigger } = await import('gsap/ScrollTrigger');
            gsap.registerPlugin(ScrollTrigger);
            document.documentElement.classList.add('motion-ready');

            // Section reveals — restrained: 20px rise, no scale, no blur.
            targets.forEach((el) => {
              const delay = Number(el.dataset.revealDelay ?? 0);
              gsap.fromTo(
                el,
                { opacity: 0, y: 20 },
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.6,
                  delay,
                  ease: 'power2.out',
                  scrollTrigger: { trigger: el, start: 'top 88%', once: true },
                },
              );
            });

            // The wheel. Rotation is the club's own metaphor, so it is the one
            // thing on this site allowed to move on its own: a very slow idle
            // turn, plus extra rotation driven by scroll position on top of it.
            const cogs = document.querySelectorAll<SVGElement>('[data-cog]');
            if (cogs.length) {
              // Two independent angles summed each frame, so neither can
              // overwrite the other: a constant idle turn, and a scroll offset.
              const angle = { idle: 0, scroll: 0 };

              gsap.set(cogs, { transformOrigin: '50% 50%' });

              gsap.to(angle, {
                idle: 360,
                duration: 100,
                ease: 'none',
                repeat: -1,
              });

              gsap.to(angle, {
                scroll: 200,
                ease: 'none',
                scrollTrigger: {
                  trigger: document.body,
                  start: 'top top',
                  end: 'bottom bottom',
                  scrub: 0.8,
                },
              });

              gsap.ticker.add(() =>
                gsap.set(cogs, { rotation: angle.idle + angle.scroll }),
              );
            }
          } catch {
            targets.forEach((el) => (el.style.opacity = '1'));
          }
        })();
      }
    </script>
  </body>
</html>
